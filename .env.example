# Optional — the app runs fully offline as a guest without these.
# Set them to enable multi-device sync, cloud backup, and account link.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
RESEND_API_KEY=your-resend-key

# Food barcode / search fallbacks (optional — Open Food Facts works without these)
# USDA FoodData Central — free demo key included, register at fdc.nal.usda.gov
# EXPO_PUBLIC_USDA_API_KEY=your-usda-key

# Nutritionix — best barcode coverage, free tier at developer.nutritionix.com
# EXPO_PUBLIC_NUTRITIONIX_APP_ID=your-app-id
# EXPO_PUBLIC_NUTRITIONIX_APP_KEY=your-app-key

# FatSecret — good UK coverage, free tier at platform.fatsecret.com
# EXPO_PUBLIC_FATSECRET_CLIENT_ID=your-client-id
# EXPO_PUBLIC_FATSECRET_CLIENT_SECRET=your-client-secret