{
  "expo": {
    "name": "fit-void",
    "slug": "fit-void",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": [
      "gymvoid",
      "com.googleusercontent.apps.799964983377-i18qbtpo6oh4ul344l6u8m4joqdvo667",
      "com.andysocial.fitvoid"
    ],
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/logo.png",
      "bundleIdentifier": "com.andysocial.voidgym",
      "buildNumber": "24",
      "appleTeamId": "T963633DC5",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "Fit Void reads your weight, workouts and nutrition to keep your logbook and analytics accurate.",
        "NSHealthUpdateUsageDescription": "Fit Void writes your workouts and weight to Apple Health so other apps can stay in sync.",
        "NSCameraUsageDescription": "Fit Void uses the camera to scan food barcodes and share workout photos with friends.",
        "NSPhotoLibraryUsageDescription": "Fit Void accesses your photo library so you can share workout photos with friends.",
        "NSPhotoLibraryAddUsageDescription": "Fit Void can save workout photos to your library.",
        "NSLocationWhenInUseUsageDescription": "Fit Void uses your location to tag gym check-ins when you share with friends."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/logo.png",
        "monochromeImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_FLOORS_CLIMBED",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_VO2_MAX",
        "android.permission.health.READ_HYDRATION",
        "android.permission.health.READ_BODY_FAT"
      ],
      "package": "com.andysocial.fitvoid"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "@bacons/apple-targets",
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/logo.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Fit Void uses the camera to scan food barcodes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-iap",
      [
        "react-native-health",
        {
          "healthSharePermission": "Fit Void reads your weight, workouts and nutrition to keep your logbook and analytics accurate.",
          "healthUpdatePermission": "Fit Void writes your workouts and weight to Apple Health so other apps can stay in sync."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "react-native-health-connect",
      "./plugins/withHealthPermissions.js",
      "expo-secure-store",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5b7e616f-f431-492f-8d0c-a835ecd25d22"
      }
    },
    "owner": "andyjxck"
  }
}
